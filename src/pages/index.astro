---
import MetaPage from '@/components/MetaPage.astro'
import { SITE, SOCIALS } from '@/consts'
import Layout from '@/layouts/Layout.astro'
---

<Layout>
  <MetaPage slot="head" />
  <hero-section>
    <profile-card>
      <profile-image>
        <img
          src="https://avatars.githubusercontent.com/u/9390245"
          alt={SITE.title}
        />
      </profile-image>
      <profile-info>
        <h1>{SITE.title}</h1>
        <p class="tagline">Software Engineer and Tech Enthusiast</p>
        <tagline-text>
          <h2>Building systems and sharing <em>insights</em> from the craft</h2>
        </tagline-text>
        <description>
          <p>
            I work on full-stack development, infrastructure, and open-source
            projects. This site is where I document lessons, experiments, and
            practical guides from real-world development.
          </p>
        </description>
        <social-links>
          {
            SOCIALS.map((social) => (
              <a href={social.href} title={social.label} class="social-link">
                <social.icon />
              </a>
            ))
          }
        </social-links>
      </profile-info>
    </profile-card>
  </hero-section>
</Layout>

<style>
  hero-section {
    display: block;
    margin-block-start: var(--space-l);
  }

  profile-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-l);
    align-items: start;

    @media (width < 48rem) {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
  }

  profile-image {
    display: flex;
    flex-shrink: 0;

    img {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid var(--border);

      @media (width < 48rem) {
        width: 100px;
        height: 100px;
      }
    }
  }

  profile-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);

    h1 {
      font-size: var(--step-3);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);
      margin: 0;
      line-height: 1.2;
    }

    .tagline {
      font-size: var(--step-0);
      color: var(--muted-foreground);
      margin: 0;
    }
  }

  tagline-text {
    h2 {
      font-size: var(--step-2);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);
      margin: 0;
      line-height: 1.3;

      em {
        font-style: italic;
        font-weight: var(--font-weight-medium);
      }
    }
  }

  description {
    p {
      font-size: var(--step-0);
      color: var(--muted-foreground);
      line-height: 1.6;
      margin: 0;
    }
  }

  social-links {
    display: flex;
    gap: var(--space-s);
    margin-block-start: var(--space-xs);

    .social-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background-color: var(--accent-bg);
      color: var(--accent-foreground);
      transition: all 0.2s ease;
      text-decoration: none;

      &:hover {
        background-color: var(--accent-foreground);
        color: var(--accent-bg);
        transform: translateY(-2px);
      }

      svg {
        width: 18px;
        height: 18px;
      }
    }
  }
</style>
